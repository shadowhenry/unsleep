{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnSleep",
  "version": "0.1.0",
  "identifier": "com.unsleep.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UnSleep",
        "width": 420,
        "height": 560,
        "minWidth": 340,
        "minHeight": 460,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
